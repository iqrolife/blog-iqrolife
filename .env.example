# Situs tetap berjalan dengan data demo ketika nilai di bawah belum diisi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Buat project di https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# Dibutuhkan hanya untuk form Kirim Cerita dan script seed.
# Buat token Editor di Sanity Manage > API > Tokens.
SANITY_API_WRITE_TOKEN=

# Optional: proteksi webhook revalidation.
SANITY_REVALIDATE_SECRET=ganti-dengan-secret-yang-kuat
